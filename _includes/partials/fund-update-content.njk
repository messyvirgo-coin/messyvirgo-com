{% set fu = fu or fundUpdate %}
{% if not fu %}
<div class="mv-card glassmorphism rounded-lg p-6 mb-8">
  <p class="mv-body mb-0">Fund update data unavailable — rebuild after API is reachable.</p>
</div>
{% else %}

<div class="mv-card glassmorphism rounded-lg p-6 mb-8">
  <p class="mv-eyebrow mb-3">Fund / Signal update · {{ fu.snapshotDate }}{% if fu.reportVersion %} · {{ fu.reportVersion }}{% endif %}</p>

  {% if showAutogenNotice %}
  <p class="mv-body text-sm text-gray-500 mb-4 pb-4 border-b border-white/10">Auto-generated at build time from <a href="https://api.messyvirgo.com" target="_blank" rel="noopener noreferrer">api.messyvirgo.com</a> and authenticated council prep (session-frozen macro/narrative when available).</p>
  {% endif %}

  <p class="mv-body mb-0 border-l-2 border-pink-400/40 pl-4 text-gray-300">Weekly workflow proof for Guru micro test funds on Base (base01, base02, base04, base05). Screening prepares evidence; the Chair decides; the system records the resolution; only then can execution mutate the book. Macro and narrative below are the postures those sessions used — not a live market refresh at publish time.</p>
</div>

{% if fu.weeklyHighlights and fu.weeklyHighlights.length %}
<div class="mv-card glassmorphism rounded-lg p-6 mb-8">
  <p class="mv-eyebrow mb-3">This week at a glance</p>
  <ul class="fu-highlights">
    {% for item in fu.weeklyHighlights %}
    <li class="fu-highlight-item">{{ item }}</li>
    {% endfor %}
  </ul>
</div>
{% endif %}

{% if fu.weekDebateDigest and fu.weekDebateDigest.bullets and fu.weekDebateDigest.bullets.length %}
<div class="mv-card glassmorphism rounded-lg p-6 mb-8">
  <p class="mv-eyebrow mb-3">{{ fu.weekDebateDigest.title or "Across the councils" }}</p>
  <ul class="fu-highlights">
    {% for item in fu.weekDebateDigest.bullets %}
    <li class="fu-highlight-item">{{ item }}</li>
    {% endfor %}
  </ul>
</div>
{% endif %}

{% if fu.readerNotes and fu.readerNotes.length %}
<div class="mv-card glassmorphism rounded-lg p-6 mb-8">
  <p class="mv-eyebrow mb-3">What's new in the app</p>
  <ul class="fu-highlights">
    {% for note in fu.readerNotes %}
    <li class="fu-highlight-item">
      {{ note.text }}
      {% if note.link %}
      <a href="{{ note.link.href }}" class="text-pink-400 hover:underline">{{ note.link.label }} →</a>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</div>
{% endif %}

<div class="mv-treasury-sep"><div class="mv-treasury-sep-inner"></div></div>

{# Week regime (session-frozen briefs + path across the week) #}
{% if fu.sessionContext and not fu.sessionContext.unavailable %}
<p class="mv-eyebrow mb-4">Week regime · what the councils used</p>
<div class="fu-session-context mv-card glassmorphism rounded-lg p-6 mb-8">
  {% if fu.sessionContext.weekPath %}
  <div class="fu-week-path mb-5">
    <p class="fu-session-label">Regime path</p>
    <p class="fu-session-regime">{{ fu.sessionContext.weekPath.label }}</p>
    {% if fu.sessionContext.weekPath.points and fu.sessionContext.weekPath.points.length %}
    <div class="fu-week-path-strip">
      {% for point in fu.sessionContext.weekPath.points %}
      <div class="fu-week-path-day">
        <span class="fu-week-path-wd">{{ point.weekday }}</span>
        <span class="fu-week-path-reg">{{ point.regimeCode }}</span>
        <span class="fu-week-path-beat">{{ point.beat }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if fu.sessionContext.weekPath.sourceFundName %}
    <p class="fu-session-meta text-sm text-gray-500 mb-0 mt-3">Sampled from {{ fu.sessionContext.weekPath.sourceFundName }} sessions across the week</p>
    {% endif %}
  </div>
  {% endif %}

  <div class="fu-session-grid">
    {% if fu.sessionContext.macro %}
    <div class="fu-session-block">
      <p class="fu-session-label">Closing macro brief</p>
      {% if fu.sessionContext.macro.regimeLabel %}
      <p class="fu-session-regime">{{ fu.sessionContext.macro.regimeLabel }}
        {% if fu.sessionContext.macro.asOf %}<span class="text-gray-500"> · as of {{ fu.sessionContext.macro.asOf }}</span>{% endif %}
      </p>
      {% endif %}
      {% if fu.sessionContext.macro.summary %}
      <p class="mv-body mb-0 text-gray-300">{{ fu.sessionContext.macro.summary }}</p>
      {% endif %}
    </div>
    {% endif %}
    {% if fu.sessionContext.tapeMotif or fu.sessionContext.narrative %}
    <div class="fu-session-block">
      <p class="fu-session-label">{{ fu.sessionContext.tapeMotif.label if fu.sessionContext.tapeMotif else "Narrative momentum" }}</p>
      {% if fu.sessionContext.tapeMotif and fu.sessionContext.tapeMotif.summary %}
      <p class="mv-body mb-0 text-gray-300">{{ fu.sessionContext.tapeMotif.summary }}</p>
      {% elif fu.sessionContext.narrative and fu.sessionContext.narrative.summary %}
      <p class="mv-body mb-0 text-gray-300">{{ fu.sessionContext.narrative.summary }}</p>
      {% endif %}
      {% if fu.sessionContext.tapeMotif and fu.sessionContext.tapeMotif.signals and fu.sessionContext.tapeMotif.signals.length %}
      <ul class="fu-session-signals">
        {% for signal in fu.sessionContext.tapeMotif.signals %}
        <li>{{ signal }}</li>
        {% endfor %}
      </ul>
      {% elif fu.sessionContext.narrative and fu.sessionContext.narrative.signals and fu.sessionContext.narrative.signals.length %}
      <ul class="fu-session-signals">
        {% for signal in fu.sessionContext.narrative.signals %}
        <li>{{ signal }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if fu.sessionContext.tapeMotif and fu.sessionContext.tapeMotif.funds and fu.sessionContext.tapeMotif.funds.length %}
      <p class="fu-session-meta text-sm text-gray-500 mb-0 mt-3">Flagged in {{ fu.sessionContext.tapeMotif.funds | join(", ") }} Chair notes</p>
      {% endif %}
    </div>
    {% endif %}
  </div>
</div>
{% elif fu.macro and not fu.macroUnavailable %}
<p class="mv-eyebrow mb-4">Market regime — macro economics</p>
<div class="fu-macro mv-card glassmorphism rounded-lg p-6 mb-6">
  <div class="fu-macro-score">
    <div class="ms-val">{{ fu.macro.score }}</div>
    <div class="ms-label">{{ fu.macro.regime }}</div>
  </div>
  <div class="fu-macro-summary">{{ fu.macro.summary }}</div>
</div>
{% endif %}

{# Older archived snapshots still include read-only Guru Lotus books #}
{% if fu.hasReadOnlyGuru %}
<p class="mv-eyebrow mb-4">Guru Lotus (read-only NAV)</p>
<div class="fu-fund-grid">
{% for fund in fu.funds %}
  {% if fund.group == "guru" %}
  <a class="fu-fund-card mv-card glassmorphism rounded-lg p-6 block text-gray-200 no-underline hover:shadow-lg hover:shadow-pink-500/20" href="{{ fund.appUrl }}" target="_blank" rel="noopener noreferrer">
    <div class="fc-name">{{ fund.name }}</div>
    <div class="fc-nav">{{ fund.nav }} NAV</div>
    <div class="fc-returns">
      <span class="fc-ret {{ fund.ret1d.cls }}">{{ fund.ret1d.value }} 1d</span>
      <span class="fc-ret {{ fund.ret7d.cls }}">{{ fund.ret7d.value }} 7d</span>
      <span class="fc-ret {{ fund.ret30d.cls }}">{{ fund.ret30d.value }} {{ fund.ret30d.window or "30d" }}</span>
    </div>
  </a>
  {% endif %}
{% endfor %}
</div>
{% endif %}

<p class="mv-eyebrow mb-4">Micro funds · week scan</p>

{% if fu.comparison and fu.comparison.length %}
<div class="fu-compare-wrap mb-8">
<table class="fu-compare-table">
  <thead>
    <tr>
      <th>Fund</th>
      <th>NAV</th>
      <th>7d</th>
      <th>Sessions</th>
      <th>Exec</th>
      <th>Hold</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    {% for row in fu.comparison %}
    <tr>
      <td><a href="{{ row.appUrl }}" class="text-pink-400 hover:underline" target="_blank" rel="noopener noreferrer">{{ row.name }}</a></td>
      <td>{{ row.nav }}</td>
      <td class="{% if row.ret7d.cls == 'pos' %}narr-chg-pos{% elif row.ret7d.cls == 'neg' %}narr-chg-neg{% endif %}">{{ row.ret7d.value }}</td>
      <td>{{ row.sessions }}</td>
      <td>{{ row.executed }}</td>
      <td>{{ row.holds }}</td>
      <td>{% if row.councilUrl %}<a href="{{ row.councilUrl }}" class="text-pink-400 hover:underline" target="_blank" rel="noopener noreferrer">Council</a>{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

<div class="fu-fund-grid fu-fund-grid--micro">
{% for fund in fu.funds %}
  {% if fund.group == "guru-micro" or fund.group == "micro" %}
  <a class="fu-fund-card mv-card glassmorphism rounded-lg p-6 block text-gray-200 no-underline hover:shadow-lg hover:shadow-pink-500/20" href="{{ fund.appUrl }}" target="_blank" rel="noopener noreferrer">
    <div class="fc-name">{{ fund.name }}</div>
    <div class="fc-nav">{{ fund.nav }} NAV</div>
    <div class="fc-returns">
      <span class="fc-ret {{ fund.ret1d.cls }}">{{ fund.ret1d.value }} 1d</span>
      <span class="fc-ret {{ fund.ret7d.cls }}">{{ fund.ret7d.value }} 7d</span>
      <span class="fc-ret {{ fund.ret30d.cls }}">{{ fund.ret30d.value }} {{ fund.ret30d.window or "30d" }}</span>
    </div>
    <div class="fc-desc">
      {% if fund.councilWeek %}
        {{ fund.councilWeek.totalSessions }} session{% if fund.councilWeek.totalSessions != 1 %}s{% endif %}
        · {{ fund.councilWeek.executedRotations }} exec
        · {{ fund.councilWeek.holdSessions }} hold
      {% elif fund.council %}
        council {{ fund.council.outcomeLabel }}
      {% else %}
        no council this week
      {% endif %}
    </div>
  </a>
  {% endif %}
{% endfor %}
</div>

<div class="mv-treasury-sep"><div class="mv-treasury-sep-inner"></div></div>

{% for fund in fu.funds %}
{% if fund.group == "guru-micro" or fund.group == "micro" or fund.group == "guru" %}
<p class="mv-eyebrow mb-4">{{ fund.name }} — council &amp; book</p>

{% if fund.council %}
<div class="fu-council{% if fund.council.targetFinalizationBlocked %} fu-council--blocked{% elif fund.council.certified == false %} fu-council--pending{% endif %}">
  <div class="fu-council-icon">{% if fund.council.outcome == "maintain_current" or fund.council.meetingOutcome == "held" %}🔒{% elif fund.council.outcome == "executed_reconciled" or fund.council.meetingOutcome == "traded" %}✅{% elif fund.council.targetFinalizationBlocked %}⚠️{% else %}⚖️{% endif %}</div>
  <div class="fu-council-body">
    <div class="fu-council-outcome">
      Closing session · {{ fund.council.outcomeLabel }}{% if fund.council.date %} · {{ fund.council.date }}{% endif %}
      {% if fund.council.executedLegCount %} · {{ fund.council.executedLegCount }} legs{% endif %}
    </div>
    <p>{{ fund.council.headline or fund.council.riskNotes or "See app for full council minutes." }}</p>
    {% if fund.weekTimeline and fund.weekTimeline.label %}
    <p class="fu-council-detail">Week strip: {{ fund.weekTimeline.label }} · {{ fund.weekTimeline.sessionCount }} sessions</p>
    {% elif fund.councilWeek %}
    <p class="fu-council-detail">Week: {{ fund.councilWeek.totalSessions }} sessions · {{ fund.councilWeek.executedRotations }} executed · {{ fund.councilWeek.holdSessions }} hold · {{ fund.councilWeek.blockedSessions }} blocked</p>
    {% endif %}
    {% if fund.councilUrl %}
    <p class="fu-council-detail mb-0"><a href="{{ fund.councilUrl }}" class="text-pink-400 hover:underline" target="_blank" rel="noopener noreferrer">Open Council minutes →</a></p>
    {% endif %}
  </div>
</div>
{% elif fund.councilWeek or fund.weekTimeline %}
<div class="fu-council">
  <div class="fu-council-body">
    <div class="fu-council-outcome">Week · {{ fund.weekTimeline.sessionCount if fund.weekTimeline else fund.councilWeek.totalSessions }} sessions</div>
    <p class="fu-council-detail mb-0">
    {% if fund.weekTimeline and fund.weekTimeline.label %}{{ fund.weekTimeline.label }}
    {% else %}{{ fund.councilWeek.executedRotations }} executed · {{ fund.councilWeek.holdSessions }} hold · {{ fund.councilWeek.blockedSessions }} blocked{% endif %}
    {% if fund.councilUrl %} · <a href="{{ fund.councilUrl }}" class="text-pink-400 hover:underline" target="_blank" rel="noopener noreferrer">Council →</a>{% endif %}
    </p>
  </div>
</div>
{% endif %}

{% if fund.weekStory and (fund.weekStory.timeline or fund.weekStory.netPosture or (fund.weekStory.earlierNotes and fund.weekStory.earlierNotes.length)) %}
<div class="fu-week-story mb-5">
  {% if fund.weekStory.timeline and fund.weekStory.timeline.days %}
  <div class="fu-week-strip">
    {% for day in fund.weekStory.timeline.days %}
    <div class="fu-week-strip-day fu-week-strip-day--{{ day.beat }}">
      <span class="fu-week-strip-wd">{{ day.weekday }}</span>
      <span class="fu-week-strip-beat">{{ day.label }}</span>
      {% if day.sessionCount > 1 %}<span class="fu-week-strip-n">×{{ day.sessionCount }}</span>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% if fund.weekStory.netPosture and fund.weekStory.netPosture.line %}
  <p class="fu-week-net">{{ fund.weekStory.netPosture.line }}</p>
  {% endif %}
  {% if fund.weekStory.earlierNotes and fund.weekStory.earlierNotes.length %}
  <div class="fu-week-earlier">
    {% for note in fund.weekStory.earlierNotes %}
    <p class="fu-week-earlier-item"><span class="fu-week-earlier-tag">{{ note.weekday }} {{ note.beat }}</span> {{ note.text }}</p>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endif %}

{% if fund.chairInsight %}
<div class="fu-chair-notes mv-card glassmorphism rounded-lg p-5 mb-6">
  <p class="fu-chair-label">{{ fund.chairInsight.scopeLabel or "Why this session" }}</p>
  {% if fund.chairInsight.postureLine %}
  <p class="fu-chair-posture">{{ fund.chairInsight.postureLine }}</p>
  {% endif %}
  {% if fund.chairInsight.postureRationale %}
  <p class="fu-chair-rationale">{{ fund.chairInsight.postureRationale }}</p>
  {% endif %}
  {% if fund.chairInsight.notes and fund.chairInsight.notes.length %}
  <ul class="fu-chair-list">
    {% for note in fund.chairInsight.notes %}
    <li>{{ note }}</li>
    {% endfor %}
  </ul>
  {% endif %}
</div>
{% endif %}

{% if fund.hasHoldingsBar and fund.holdingsBar.length %}
<div class="fu-holdings">
  <div class="fu-holdings-label">Current book</div>
  {% if fund.bookPosture and fund.bookPosture.label %}
  <div class="fu-book-posture">{{ fund.bookPosture.label }}</div>
  {% endif %}
  <div class="fu-bar">
    {% for seg in fund.holdingsBar %}
    <div class="fu-bar-seg{% if seg.kind == 'cash' or seg.kind == 'base' %} fu-bar-seg--sleeve{% endif %}" style="width:{{ seg.weight }}%;background:{{ seg.color }};opacity:0.9" title="{% if seg.detail %}{{ seg.symbol }} ({{ seg.detail }}){% else %}{{ seg.symbol }}{% endif %} {{ seg.weight }}%"></div>
    {% endfor %}
  </div>
  <div class="fu-bar-legend">
    {% for seg in fund.holdingsBar %}
    <span class="fu-leg{% if seg.kind == 'cash' or seg.kind == 'base' %} fu-leg--sleeve{% endif %}">
      <span class="fu-leg-dot" style="background:{{ seg.color }}"></span>
      {% if seg.kind == 'cash' or seg.kind == 'base' %}
      {{ seg.symbol }}{% if seg.detail %} <span class="fu-leg-detail">({{ seg.detail }})</span>{% endif %} {{ seg.weight }}%
      {% else %}
      {{ seg.symbol }} {{ seg.weight }}%{% if seg.warning %} ⚠️{% endif %}
      {% endif %}
    </span>
    {% endfor %}
  </div>
</div>
{% endif %}

{% if fund.screening and fund.screening.aggCandidates and fund.screening.aggCandidates.length %}
<p style="font-size:.8rem;color:#6b7280;margin-bottom:.5rem;">
  <strong style="color:#9ca3af;">Top aggregate candidates</strong>
  {% if fund.screening.aggLookback %} — {{ fund.screening.aggLookback }}-day lookback{% endif %}
  {% if fund.screening.aggDate %}, as of {{ fund.screening.aggDate }}{% endif %}
</p>
<div class="fu-candidates">
  {% for c in fund.screening.aggCandidates %}
  <div class="fu-cand-row">
    <span class="fu-cand-rank">#{{ c.rank }}</span>
    <span class="fu-cand-sym">{{ c.symbol }}</span>
    <span class="fu-cand-reason">{{ c.reason }}</span>
  </div>
  {% endfor %}
</div>
{% endif %}

{% if not loop.last %}<div class="mv-treasury-sep"><div class="mv-treasury-sep-inner"></div></div>{% endif %}
{% endif %}
{% endfor %}

{% if fu.signalExample or fu.riskReject %}
<div class="mv-treasury-sep"><div class="mv-treasury-sep-inner"></div></div>
<p class="mv-eyebrow mb-4">Aggregate signal{% if fu.riskReject %} · Risk reject{% endif %}</p>
<div class="fu-signal-grid">
  {% if fu.signalExample %}
  <div class="fu-signal-card candidate">
    <div class="fu-signal-eyebrow">✅ Aggregate signal</div>
    <div class="fu-signal-token">{{ fu.signalExample.symbol }}</div>
    <div class="fu-signal-name">{{ fu.signalExample.name }}</div>
    <div class="fu-signal-body">{{ fu.signalExample.body | safe }}</div>
  </div>
  {% endif %}
  {% if fu.riskReject %}
  <div class="fu-signal-card reject">
    <div class="fu-signal-eyebrow">❌ Risk reject</div>
    <div class="fu-signal-token">{{ fu.riskReject.symbol }}</div>
    <div class="fu-signal-name">{{ fu.riskReject.name }} · {{ fu.riskReject.fundName }}</div>
    <div class="fu-signal-body">{{ fu.riskReject.body }}</div>
  </div>
  {% endif %}
</div>
{% endif %}

<div class="mv-treasury-sep"><div class="mv-treasury-sep-inner"></div></div>

<div class="fu-agent-box mv-card glassmorphism rounded-lg p-6 mb-8">
  <h3 class="mv-eyebrow mb-4">What this teaches the future Fund Agent</h3>
  <div class="fu-agent-patterns">
    <div class="fu-pattern">
      <div class="fu-pattern-num">1</div>
      <div class="fu-pattern-text"><strong>Macro gates exposure.</strong> Use the session-frozen regime the council actually saw{% if fu.sessionContext and fu.sessionContext.macro and fu.sessionContext.macro.regimeLabel %} (this week: {{ fu.sessionContext.macro.regimeLabel }}){% endif %} — not a later live refresh.</div>
    </div>
    <div class="fu-pattern">
      <div class="fu-pattern-num">2</div>
      <div class="fu-pattern-text"><strong>Daily screen ≠ automatic trade.</strong> Aggregate leaders inform the slate; they do not bypass Chair decision or execution gates.</div>
    </div>
    <div class="fu-pattern">
      <div class="fu-pattern-num">3</div>
      <div class="fu-pattern-text"><strong>Chair decides, system records.</strong> Seats analyze and propose; the Chair adjudicates; minutes and execution receipts stay public on each fund’s Council tab.</div>
    </div>
  </div>
</div>

<div class="mv-treasury-sep"><div class="mv-treasury-sep-inner"></div></div>

<p class="mv-eyebrow mb-4">Inspect the same workflow</p>

<div class="fu-links-grid">
  <a class="fu-link-pill mv-card glassmorphism rounded-lg p-4" href="https://app.messyvirgo.com/funds" target="_blank" rel="noopener noreferrer"><span class="fu-link-icon" aria-hidden="true">🏦</span> All Funds</a>
  {% for fund in fu.funds %}
  {% if fund.group == "guru-micro" or fund.group == "micro" %}
  <a class="fu-link-pill mv-card glassmorphism rounded-lg p-4" href="{{ fund.councilUrl or fund.appUrl }}" target="_blank" rel="noopener noreferrer"><span class="fu-link-icon" aria-hidden="true">⚖️</span> {{ fund.name }} Council</a>
  {% endif %}
  {% endfor %}
  <a class="fu-link-pill mv-card glassmorphism rounded-lg p-4" href="https://app.messyvirgo.com/macro-economics" target="_blank" rel="noopener noreferrer"><span class="fu-link-icon" aria-hidden="true">🌐</span> Macros</a>
  <a class="fu-link-pill mv-card glassmorphism rounded-lg p-4" href="https://app.messyvirgo.com/narratives" target="_blank" rel="noopener noreferrer"><span class="fu-link-icon" aria-hidden="true">📈</span> Narratives</a>
</div>

{% if showAutogenNotice %}<p style="margin-top:2rem;font-size:.82rem;color:#6b7280;text-align:center">Data auto-fetched at build time</p>{% endif %}

{% endif %}
